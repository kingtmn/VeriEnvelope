{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verienvelope.local/schemas/component.schema.json",
  "title": "ComponentIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "component_type",
    "description",
    "source_repository",
    "version",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "component_type": {
      "enum": ["tool", "mcp_server"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_repository": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["candidate", "withdrawn"]
    }
  }
}
