{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verienvelope.local/schemas/seal.schema.json",
  "title": "EvidencePackageSeal",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "algorithm", "files"],
  "properties": {
    "kind": { "const": "evidence_package_seal" },
    "algorithm": { "const": "sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
